# --- Core ---
DATABASE_URL="file:./data/contribution-checker.db"
PUBLIC_BASE_URL="http://localhost:3000"

# --- Hexclave (self-hosted Stack Auth) — human login ---
# Login is handled by your self-hosted Hexclave instance. Configure GitHub as a
# sign-in provider INSIDE Hexclave (reuse the GitHub App's client id/secret
# below; callback https://<your-hexclave>/api/v1/auth/oauth/callback/github),
# and define two project permissions: super_admin and create_project.
#
# NOTE: these are deliberately NOT prefixed NEXT_PUBLIC_. They are read
# server-side at RUNTIME (so one CI-built image can be configured per-deploy)
# and reach the browser via <StackProvider> serialization, never inlined at
# build time. The project id + publishable client key are public values.
# The secret server key may live in Vault (VAULT_STACK_SECRET_SERVER_KEY_PATH).
STACK_PROJECT_ID=""
STACK_PUBLISHABLE_CLIENT_KEY=""
STACK_SECRET_SERVER_KEY=""
# Point the SDK at your self-hosted backend (omit to use the managed cloud).
STACK_API_URL="https://your-hexclave-backend.example.com"
# Svix signing secret for /api/stack/webhook (Hexclave -> local user sync).
STACK_WEBHOOK_SECRET=""

# --- NextAuth (Auth.js v5) — LEGACY, no longer used ---
# Superseded by Hexclave above. AUTH_SECRET is no longer required; these are
# kept only for rollback and are removed in the post-cutover cleanup.
AUTH_SECRET=""
AUTH_URL=""
AUTH_TRUST_HOST=""

# --- GitHub authentication ---
# These GitHub App OAuth credentials are now used to configure Hexclave's
# GitHub sign-in provider (no longer consumed by this app for login). The
# AUTH_GITHUB_* split-app option is legacy.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- GitHub App (for repo automation + sign-in in single-App mode) ---
# Bootstrap via /admin/setup after first super-admin login. The setup page
# shows the values to paste here once GitHub creates the App.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_SLUG="contribution-checker"
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# --- Bootstrap allowlist ---
# Comma-separated GitHub logins. Super-admins can manage from UI after bootstrap.
SUPER_ADMINS=""
PROJECT_CREATORS=""

# --- SMTP (outbound email) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Contribution Checker <noreply@example.com>"

# --- OpenRouter (AI features) ---
# Optional. Powers application triage, PR/QA summaries, the release narrative and
# the AI quality signal. Every AI surface is off until a project opts in, and the
# whole subsystem short-circuits when the key is absent, so leaving this empty
# changes nothing about how the app behaves.
#
# The key may live in Vault instead (VAULT_OPENROUTER_API_KEY_PATH); it is read
# with getSecret() inside the Temporal activity, never from process.env on the
# request path, and never passed as an activity argument.
OPENROUTER_API_KEY=""

# Two tiers. The cheap model handles triage, QA steps and the quality signal:
# short context, constrained JSON output, the regime where a small model is close
# to a large one. The judgment model is used only by the release narrative, the
# one task doing real synthesis. Pin both to the cheap model in development.
#
# Defaults picked by measurement: gpt-oss-120b passed all seven task cases
# including the prompt-injection case, and costs nothing under a Groq BYOK key.
# Proven alternatives: google/gemini-3.5-flash-lite (same passes, ~4x cost) and
# google/gemini-3.7-flash. Do not use a Gemini 2.5 slug: Google retired that line
# for new users and it 404s on BYOK however cheap the rate card looks.
#
# Note gpt-oss is a reasoning model and spends most of its completion thinking,
# so AI_MAX_OUTPUT_TOKENS needs real headroom above the size of the JSON answer.
AI_MODEL_CHEAP="openai/gpt-oss-120b"
AI_MODEL_JUDGMENT="openai/gpt-oss-120b"

# Defaults shown; override only if you need to.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# AI_MAX_OUTPUT_TOKENS="2048"
# Pin routing to providers whose weights were validated against the
# prompt-injection case. Unset uses OpenRouter's default, which prefers a BYOK
# route and so costs nothing while a free tier lasts. Validated: Groq, AkashML.
# AI_PROVIDER_ORDER="Groq,AkashML"
# AI_REQUEST_TIMEOUT_MS="45000"

# --- Misc ---
LOG_LEVEL="info"

# --- Sentry ---
# Observability: errors, traces, profiles, replays, metrics, logs.
# Sample rates are hardcoded to 1.0 in sentry.server.config.ts and
# instrumentation-client.ts. 100% in production can produce very high
# Sentry-side cost on a busy deploy; lower the rates in those files if needed.
# When SENTRY_DSN is unset the SDK no-ops cleanly (safe for tests/CI).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Required for source-map upload at build time. Build still succeeds without.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- HashiCorp Vault (optional) ---
# When VAULT_ADDR is set, secrets with a configured VAULT_<NAME>_PATH are read
# from Vault. The resolver serves a cached value instantly and silently
# revalidates it in the background, so a brief Vault outage never breaks a
# request: the last-known-good value keeps being served (up to the serve
# ceiling below). Any secret without a path falls back to its plain env var.
# DATABASE_URL and AUTH_SECRET remain env-only: they're consumed synchronously
# at module load. All resilience knobs below have safe defaults; existing
# deployments need no changes.
#VAULT_ADDR="https://vault.example.com"
#VAULT_NAMESPACE=""                       # Vault Enterprise namespaces only
#VAULT_AUTH_METHOD="token"                # "token" or "approle"
#VAULT_TOKEN=""                           # required when AUTH_METHOD="token"
#VAULT_APPROLE_ROLE_ID=""                 # required when AUTH_METHOD="approle"
#VAULT_APPROLE_SECRET_ID=""
#VAULT_APPROLE_MOUNT="approle"
#VAULT_CACHE_TTL_SECONDS="43200"          # serve last-known-good up to this long during an outage (12h)
#VAULT_REVALIDATE_INTERVAL_SECONDS="15"   # min gap between silent background refreshes (0 = revalidate on every access)
#VAULT_TIMEOUT_MS="5000"                  # per-attempt request timeout
#VAULT_MAX_RETRIES="2"                    # retries on transient errors (timeout, 5xx) only
#VAULT_BREAKER_THRESHOLD="5"              # consecutive failures before the circuit breaker opens
#VAULT_BREAKER_COOLDOWN_MS="30000"        # how long the breaker stays open (skips Vault, serves stale)
#
# Per-secret KV v2 paths. Format: "<full-path>[#<field>]". Without a #field,
# the resolver looks for a key named "value" in the KV payload. Setting any
# of these takes precedence over the env var of the same name.
#VAULT_GITHUB_APP_ID_PATH="secret/data/cc/github#app_id"
#VAULT_GITHUB_APP_PRIVATE_KEY_PATH="secret/data/cc/github#private_key"
#VAULT_GITHUB_APP_WEBHOOK_SECRET_PATH="secret/data/cc/github#webhook_secret"
#VAULT_GITHUB_APP_CLIENT_ID_PATH="secret/data/cc/github#client_id"
#VAULT_GITHUB_APP_CLIENT_SECRET_PATH="secret/data/cc/github#client_secret"
#VAULT_GITHUB_APP_SLUG_PATH="secret/data/cc/github#slug"
#VAULT_AUTH_GITHUB_ID_PATH=""
#VAULT_AUTH_GITHUB_SECRET_PATH=""
#VAULT_SMTP_HOST_PATH="secret/data/cc/smtp#host"
#VAULT_SMTP_PORT_PATH="secret/data/cc/smtp#port"
#VAULT_SMTP_USER_PATH="secret/data/cc/smtp#user"
#VAULT_SMTP_PASS_PATH="secret/data/cc/smtp#password"
#VAULT_SMTP_FROM_PATH="secret/data/cc/smtp#from"
#VAULT_TEMPORAL_TLS_CERT_PATH="secret/data/cc/temporal#client_cert"
#VAULT_TEMPORAL_TLS_KEY_PATH="secret/data/cc/temporal#client_key"
#VAULT_TEMPORAL_TLS_CA_PATH="secret/data/cc/temporal#ca_cert"

# --- Temporal (durable execution) ---
# The Temporal worker runs as a second process beside `next start`; the Next.js
# app starts/signals workflows over the same connection. Point both at your
# self-hosted Temporal frontend. In production set TEMPORAL_TLS_ENABLED=true and
# provide the client cert/key (and optional CA) via Vault paths above, or via
# the TEMPORAL_TLS_CERT / TEMPORAL_TLS_KEY / TEMPORAL_TLS_CA env vars (PEM).
# For local dev, run `temporal server start-dev` (docker-compose has a service)
# and leave TLS disabled.
TEMPORAL_HOST="localhost"
TEMPORAL_PORT="7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="contribution-checker"
TEMPORAL_TLS_ENABLED="false"
# Each TLS value below may be EITHER a mounted PEM file path (e.g.
# /app/data/certs/client.pem) OR the inline PEM text. Vault paths
# (VAULT_TEMPORAL_TLS_*_PATH above) take precedence over these when set.
#TEMPORAL_TLS_SERVER_NAME=""              # hostname on the server cert (set when connecting by IP / when cert CN != TEMPORAL_HOST)
#TEMPORAL_TLS_CERT=""                     # client cert: PEM text or /path/to/client.pem
#TEMPORAL_TLS_KEY=""                      # client private key: PEM text or /path/to/key.pem
#TEMPORAL_TLS_CA=""                       # CA that signed the SERVER cert: PEM text or /path/to/ca.pem (needed for a private/self-signed CA)

# --- Temporal Worker Deployments / Versioning (optional) ---
# https://docs.temporal.io/worker-deployments. When enabled, the worker joins a
# Deployment under a Build ID, enabling safe rolling deploys and the worker/
# version heartbeats the server tracks. REQUIRES the Temporal server to have
# `frontend.workerHeartbeatsEnabled: true` (dev server: pass
# `--dynamic-config-value frontend.workerHeartbeatsEnabled=true`; real cluster:
# set it in the dynamicconfig YAML).
TEMPORAL_VERSIONING_ENABLED="false"
TEMPORAL_DEPLOYMENT_NAME="contribution-checker"
# Unique per worker code version. In Docker this is baked from the BUILD_ID
# build-arg (git short sha) — see docker/Dockerfile. Set it directly only when
# running the worker outside the image.
#TEMPORAL_BUILD_ID=""
# AUTO_UPGRADE (in-flight workflows migrate to the newest Build ID on next task;
# best for the long-lived cooldown/entity workflows) or PINNED (stay on their
# starting version until done; old workers must linger until they finish).
TEMPORAL_DEFAULT_VERSIONING_BEHAVIOR="AUTO_UPGRADE"
# Auto-promote this Build ID to the deployment's Current version once the worker
# registers (removes the manual "Set Current" step in the Temporal UI). Fine for
# a single-worker setup; set false if you want to verify/canary before shifting
# traffic.
TEMPORAL_SET_CURRENT_ON_START="false"
