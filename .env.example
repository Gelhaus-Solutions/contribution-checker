# --- Core ---
DATABASE_URL="file:./data/contribution-checker.db"
PUBLIC_BASE_URL="http://localhost:3000"

# --- NextAuth (Auth.js v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- GitHub authentication ---
# Single-App mode (recommended): leave AUTH_GITHUB_* blank and the GitHub
# App's client_id/client_secret are reused for human sign-in. The App's
# manifest at /admin/setup includes the OAuth callback URL automatically.
#
# Two-App mode: create a separate OAuth App at https://github.com/settings/developers
# and put its credentials here. Only needed if you want sign-in to work
# with a different App than the one doing repo automation.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- GitHub App (for repo automation + sign-in in single-App mode) ---
# Bootstrap via /admin/setup after first super-admin login. The setup page
# shows the values to paste here once GitHub creates the App.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""
GITHUB_APP_SLUG="contribution-checker"
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

# --- Bootstrap allowlist ---
# Comma-separated GitHub logins. Super-admins can manage from UI after bootstrap.
SUPER_ADMINS=""
PROJECT_CREATORS=""

# --- SMTP (outbound email) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Contribution Checker <noreply@example.com>"

# --- Misc ---
LOG_LEVEL="info"

# --- Sentry ---
# Observability: errors, traces, profiles, replays, metrics, logs.
# Sample rates are hardcoded to 1.0 in sentry.server.config.ts and
# instrumentation-client.ts. 100% in production can produce very high
# Sentry-side cost on a busy deploy; lower the rates in those files if needed.
# When SENTRY_DSN is unset the SDK no-ops cleanly (safe for tests/CI).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# Required for source-map upload at build time. Build still succeeds without.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
