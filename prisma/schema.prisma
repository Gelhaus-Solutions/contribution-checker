generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; "debian-openssl-3.0.x" is the production runtime
  // (node:24-slim / Debian bookworm). Pinned explicitly so the generated client
  // always ships the engine the container needs, regardless of where generate
  // ran.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- NextAuth tables (Auth.js Prisma adapter) -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- Domain -----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Hexclave (Stack Auth) identity link. The local `id` stays the FK target for
  // every relation below; this column just maps a local row to its Hexclave
  // user. Set by the backfill, or lazily on first sign-in (see
  // src/lib/auth/sync-user.ts). Null until a user has authenticated post-migration.
  stackUserId String? @unique

  // GitHub identity (populated on first sign-in via OAuth profile)
  ghId    Int?    @unique
  ghLogin String? @unique

  // Profile. `country` is an ISO 3166-1 alpha-2 code collected once in the
  // post-login onboarding interstitial and mirrored from Hexclave
  // clientReadOnlyMetadata (Hexclave remains the canonical store).
  country String?

  // Authorization flags. With the Hexclave migration these mirror the
  // project-level Hexclave permissions `super_admin` / `create_project`
  // (reconciled on every sign-in from SUPER_ADMINS/PROJECT_CREATORS); Hexclave
  // is the source of truth, these columns are a query-convenience cache.
  isSuperAdmin  Boolean @default(false)
  canCreateProj Boolean @default(false)

  createdAt DateTime @default(now())

  accounts        Account[]
  sessions        Session[]
  memberships     ProjectMember[]
  applications    Application[]
  notifications   Notification[]
  decidedApps     Application[]      @relation("ApplicationDecidedBy")
  decidedManual   ManualDecision[]   @relation("ManualDecisionDecidedBy")
  appNotes        ApplicationNote[]
  appReviews      ApplicationReview[]
  resolvedAppeals ApplicationAppeal[] @relation("AppealResolvedBy")
  auditedEvents   AuditEvent[]
  formTemplates   FormTemplate[]
  claSignatures   ClaSignature[]
}

model Project {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  // Form schema: Field[] (see src/lib/applications/schema.ts)
  formSchema    String  @default("[]")
  templateId    String?

  // Default cooldown applied to new denials when "Allow resubmitting" is checked.
  // Null = no cooldown (instant resubmit if resubmitting is allowed).
  // Per-denial behavior is captured in Application.allowResubmit + cooldownUntil.
  cooldownDays  Int?

  // Bypass list: JSON-stringified array of GitHub login patterns (supports * glob)
  bypassHandles String  @default("[]")
  bypassCollabs Boolean @default(true)

  // PR labels
  labelsEnabled Boolean @default(true)
  labelPending  String  @default("contribution:pending")
  labelApproved String  @default("contribution:approved")
  labelDenied   String  @default("contribution:denied")
  // Manual re-eval trigger: admins add this label to a PR to force the
  // checker to re-run (reopens closed-by-app PRs that now pass, or evaluates
  // PRs opened before the App was installed). Always removed by the bot
  // after processing, regardless of labelsEnabled.
  labelEvaluate String  @default("contribution:evaluate")
  // Staging labels deliberately live OUTSIDE the `contribution:` namespace:
  // setLabels() owns that namespace and strips every `contribution:*` label it
  // did not just set, so a staging label placed there would be wiped by the
  // next gate converge. updateLabelSettings rejects the prefix for this reason.
  //
  // Carried by the bot's own staging -> default aggregate PR, so the retarget
  // path can recognize it and the reconciler can find it again if the tracked
  // number is lost.
  labelStagingBatch  String @default("staging:batch")
  // Escape hatch: a PR carrying this label is never retargeted to staging,
  // and keeps targeting the default branch.
  labelStagingOptOut String @default("staging:opt-out")

  // Staging routing. Two independent switches:
  //  - stagingRetargetEnabled rewrites PRs based on the default branch to
  //    target `stagingBranch` instead.
  //  - stagingBatchPrEnabled keeps one open aggregate PR from `stagingBranch`
  //    to the default branch, whose description lists the batch.
  // Both off by default; enabling either only affects App-mode repos.
  stagingRetargetEnabled Boolean @default(false)
  stagingBatchPrEnabled  Boolean @default(false)
  stagingBranch          String  @default("staging")

  // Disable switch: when checkerEnabled=false, every PR is treated as APPROVED.
  // Tracking (PrCheck rows + quality scoring) only runs if trackWhenDisabled=true.
  checkerEnabled    Boolean @default(true)
  trackWhenDisabled Boolean @default(false)

  // GitHub Check Runs publishing. Skipped if installation lacks `checks:write`.
  checksEnabled Boolean @default(true)

  // PR Quality scoring (heuristic-based, anti-slop style).
  qualityEnabled      Boolean @default(false)
  // JSON: { [heuristicId]: { enabled: boolean, threshold?: any } }
  qualityConfig       String  @default("{}")
  // Score below this triggers a public PR comment with breakdown. Default 20.
  qualityCommentMin   Int     @default(20)
  // JSON array of strings: hidden honeypot tokens injected into the project's
  // PR template; PRs whose body contains any of these score `pr.honeypot_hit`.
  prTemplateHoneypots String  @default("[]")
  // Fuzzy match strictness (0–100) for `pr.uses_template` checkbox matching.
  // 100 = exact substring match; lower = tolerate typos/edits. Default 80.
  qualityTemplateMatchPct Int @default(80)

  // PR-style review gate: minimum number of distinct approving reviews
  // (excluding the actor) required before approveApplication is allowed.
  // 0 = no gate (legacy behavior).
  requireApprovalCount Int @default(0)

  // Disable the *application* requirement only (distinct from checkerEnabled,
  // which disables the whole checker). When false, the application gate is
  // skipped (missing/submitted applications no longer block) but CLA + DCO +
  // quality scoring still apply. Existing DENIED applications still block.
  applicationRequired Boolean @default(true)

  // When true, an applicant whose application was DENIED may file a single
  // appeal (free-text message plus revised answers) on /p/<slug>. Reviewers
  // resolve appeals (grant / allow-resubmit / reject) from the application
  // detail page. Independent of allowResubmit/cooldown: an alternate channel.
  allowAppeals Boolean @default(false)

  // ----- CLA (Contributor License Agreement) -----
  claEnabled             Boolean @default(false)
  // Gate (block PRs / approval until signed) vs record-only.
  claRequired            Boolean @default(true)
  // Allow the Corporate CLA path (company signs + maintains an employee roster).
  claCorporateEnabled    Boolean @default(true)
  // Whether a newly signed Corporate CLA must be approved by an admin before it
  // confers coverage. When true, new CCLAs start PENDING; an admin approves
  // (-> ACTIVE) or rejects (-> REJECTED). When false they go straight to ACTIVE.
  claCorporateRequiresApproval Boolean @default(true)
  // Placement: a required acceptance step embedded in the application form,
  // and/or a standalone signing page at /p/<slug>/cla.
  claPlacementEmbed      Boolean @default(true)
  claPlacementStandalone Boolean @default(true)
  // Separate label for "approved but CLA/DCO unsigned" PRs (distinct from
  // labelPending so the two block reasons are visually distinct on GitHub).
  labelClaPending        String  @default("contribution:cla-pending")
  // DERIVED/ADVISORY (no longer the gate): lowest signature version per kind that
  // still satisfied the gate under the old monotonic-floor model. Coverage now
  // reads ClaDocumentVersion.resignRequired per-version (see src/lib/cla/status.ts).
  // Still written by publishClaVersion for backward-compat and UI hints.
  minIclaVersion         Int     @default(0)
  minCclaVersion         Int     @default(0)
  // Denormalized pointers to the active published document per kind (fast gate).
  currentIclaVersionId   String?
  currentCclaVersionId   String?
  // When a repo-file CLA auto-versions on push, whether that forces re-sign. In
  // review mode this only pre-fills the approval form's re-sign default.
  claAutoVersionRequiresResign Boolean @default(false)
  // When true, a detected repo-file change (push or manual sync) creates a
  // pending ClaPendingChange for admin review instead of auto-publishing. Takes
  // precedence over claAutoVersionRequiresResign for the publish-vs-queue choice.
  claRepoFileReviewMode  Boolean @default(false)
  // Whether an ICLA requires a typed signature (full legal name). When false,
  // the "I agree" checkbox alone is a valid individual click-wrap. (CCLA always
  // requires the full executed signature block.)
  claIclaRequireSignature Boolean @default(true)
  // Admin-defined custom fields collected at signing time, as JSON Field[]
  // (same schema as the application form; see src/lib/applications/schema.ts).
  // Answers are stored immutably on ClaSignature.customFields.
  claIclaCustomFields String @default("[]")
  claCclaCustomFields String @default("[]")

  // ----- DCO (Developer Certificate of Origin): independent of CLA -----
  dcoEnabled Boolean @default(false)

  // Hexclave (Stack Auth) team backing this project. Stack Auth is the source
  // of truth for membership/roles; this maps the project to its team. Null for
  // legacy/unmigrated projects or when team creation failed (reconciled by the
  // backfill/webhook). Unique: one project = one team.
  teamId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ProjectMember[]
  repos        Repo[]
  applications Application[]
  appeals      ApplicationAppeal[]
  audits       AuditEvent[]
  webhookEndpoints  ProjectWebhook[]
  manualDecisions  ManualDecision[]
  template     FormTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  claDocumentVersions ClaDocumentVersion[]
  claSignatures       ClaSignature[]
  corporateClas       CorporateCla[]
  cclaRosterMembers   CclaRosterMember[]
  claWaivers          ClaWaiver[]
  claEvents           ClaEventLog[]
  claPendingChanges   ClaPendingChange[]
}

/**
 * Outbound webhook endpoint. Each project can have any number of these.
 * `kind` controls payload formatting and signing:
 *   - "generic": JSON body identical to the legacy single-webhook contract,
 *     signed with HMAC-SHA256 in `X-ContribCheck-Signature` when `secret` is set.
 *   - "discord": body transformed to a Discord-compatible message (content +
 *     embed). No signing; `secret` is ignored.
 */
model ProjectWebhook {
  id        String  @id @default(cuid())
  projectId String
  name      String?
  kind      String  @default("generic") // "generic" | "discord"
  url       String
  secret    String?
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/**
 * Admin-set approve/deny on a GitHub login, no application required.
 * Checked BEFORE applications in the PR decision flow. If a row exists
 * for (projectId, ghLogin), it wins.
 */
model ManualDecision {
  id          String   @id @default(cuid())
  projectId   String
  ghLogin     String   // canonical lowercase GH login
  ghId        Int?     // captured opportunistically
  status      String   // "APPROVED" | "DENIED"
  reason      String?
  decidedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("ManualDecisionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([projectId, ghLogin])
  @@index([ghId])
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String // "OWNER" | "ADMIN" | "REVIEWER" -- bundle cache (display + owner-only checks)

  // Synced cache of the member's effective LEAF permission ids (JSON string[]),
  // mirroring the Stack Auth team-permission recursive expansion of their role
  // bundle plus any explicit extra grants. The hot path (requireProjectPermission)
  // reads this so gating needs no Stack Auth round-trip. Reconciled on every
  // membership write and by the team webhook. Parse via the helper in
  // src/lib/authz.ts (never JSON.parse-and-trust).
  permissions String @default("[]")

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Repo {
  id                 String  @id @default(cuid())
  projectId          String
  ghRepoId           Int?    @unique // numeric GH id (survives renames); null until App is installed
  fullName           String          // "owner/name", cached
  installationId     Int?            // GH App installation id; null = manually entered, App not installed yet
  requireOwnApproval Boolean @default(false)
  active             Boolean @default(true) // false if installation was uninstalled

  // Cached default branch name, refreshed opportunistically from PR/push
  // webhook payloads and, as a last resort, from GET /repos/{owner}/{repo}.
  defaultBranch String?
  // Staging routing state. `stagingBatchPrNumber` is the open aggregate PR
  // (null = no batch in flight). `stagingBatchSince` is when the previous
  // aggregate PR merged: PRs merged into staging before it are already in the
  // default branch and are excluded from the next batch's manifest.
  stagingBatchPrNumber Int?
  stagingBatchSince    DateTime?

  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prChecks PrCheck[]

  @@unique([projectId, fullName])
  @@index([projectId])
}

model Application {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  repoId    String?  // set if requireOwnApproval was hit (per-repo opt-out)
  status    String   @default("SUBMITTED") // "SUBMITTED" | "APPROVED" | "DENIED"

  // JSON-stringified { fieldId: value }
  answers   String   @default("{}")

  decidedById String?
  decidedAt   DateTime?
  reason      String?

  // Denial controls. Only meaningful when status = "DENIED".
  // allowResubmit=false → applicant cannot re-apply without admin action.
  // allowResubmit=true + cooldownUntil null/elapsed → derived "pending" (can apply now).
  // allowResubmit=true + cooldownUntil > now → "denied; can re-apply on {date}".
  allowResubmit Boolean   @default(true)
  cooldownUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?               @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  notes     ApplicationNote[]
  reviews   ApplicationReview[]
  appeal    ApplicationAppeal?
  claSignatures ClaSignature[]

  @@index([projectId, status])
  @@index([userId])
}

/**
 * A contributor's appeal of a DENIED application. Available only when the
 * project has allowAppeals=true. Exactly one appeal per application (enforced
 * by the unique applicationId). Carries a free-text message plus revised
 * answers (JSON-stringified { fieldId: value }, validated against the
 * project's current formSchema at submit time via buildAnswersSchema).
 *
 * Lifecycle: created PENDING by submitAppeal (src/lib/applications/lifecycle.ts).
 * Resolved by resolveAppeal (src/lib/applications/decide.ts) to one of:
 *   GRANTED          (application approved; answers replaced with the revised
 *                     ones, then approveApplication runs and reopens PRs)
 *   RESUBMIT_ALLOWED (allowApplicationResubmit ran; application stays DENIED)
 *   REJECTED         (appeal closed; application stays DENIED)
 * resolvedById/resolvedAt/resolutionNote are set on any resolution.
 */
model ApplicationAppeal {
  id            String   @id @default(cuid())
  applicationId String   @unique
  projectId     String
  status        String   @default("PENDING") // "PENDING" | "GRANTED" | "RESUBMIT_ALLOWED" | "REJECTED"

  // Free-text appeal message from the applicant.
  message String

  // JSON-stringified { fieldId: value }: revised answers validated against the
  // project's current formSchema at submit time. Same encoding as Application.answers.
  answers String @default("{}")

  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolvedBy  User?       @relation("AppealResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

/**
 * Comment on an application. Either:
 *  - a free-form internal note (reviewId=null, fieldId=null, parentId=null)
 *  - a per-field review comment (fieldId set; matches fieldIdSchema in
 *    src/lib/applications/schema.ts). Stays a draft until linked to a
 *    submitted ApplicationReview via reviewId.
 *  - a threaded reply (parentId set). Visibility inherits from the parent;
 *    when the parent is APPLICANT-visible, the application's applicant is
 *    allowed to author replies (no project role required).
 *
 * visibility: "INTERNAL" (project members only) | "APPLICANT" (also visible
 * to the applicant on the apply/status page).
 *
 * Edits are in-place: updatedAt > createdAt ⇒ render an "edited" marker.
 * Deletes are soft (deletedAt set) so threads stay coherent; UI renders a
 * tombstone in place of the body.
 */
model ApplicationNote {
  id            String    @id @default(cuid())
  applicationId String
  authorId      String
  reviewId      String?
  parentId      String?
  fieldId       String?
  visibility    String    @default("INTERNAL")
  body          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  review      ApplicationReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  parent      ApplicationNote?   @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ApplicationNote[]  @relation("NoteReplies")

  @@index([applicationId, fieldId])
  @@index([reviewId])
  @@index([parentId])
}

/**
 * A reviewer's submitted review on an application, analogous to a GitHub
 * pull-request review. Carries an overall state and an optional summary
 * body (markdown). Per-field comments (ApplicationNote rows with fieldId
 * set) are linked to a review via ApplicationNote.reviewId at submission
 * time, and inherit visibility from the review's state:
 *
 *   APPROVED          ⇒ INTERNAL (LGTM signal between reviewers)
 *   CHANGES_REQUESTED ⇒ APPLICANT (feedback the applicant can see + reply to)
 *   COMMENTED         ⇒ author chooses INTERNAL or APPLICANT per submit
 *
 * Reviews can be soft-dismissed (deletedAt set) by an ADMIN; dismissed
 * reviews don't count toward the approval gate.
 */
model ApplicationReview {
  id            String    @id @default(cuid())
  applicationId String
  authorId      String
  state         String    // "APPROVED" | "CHANGES_REQUESTED" | "COMMENTED"
  body          String?
  visibility    String    @default("INTERNAL") // "INTERNAL" | "APPLICANT"
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    ApplicationNote[]

  @@index([applicationId, state])
  @@index([authorId])
}

model PrCheck {
  id            String   @id @default(cuid())
  repoId        String
  prNumber      Int
  prNodeId      String
  authorGhLogin String
  authorGhId    Int
  status        String // "PENDING" | "APPROVED" | "DENIED" | "BYPASSED" | "CHECK_REQUIRED"
  closedByApp   Boolean  @default(false)
  // For CHECK_REQUIRED PRs (CLA/DCO): why the Check is failing, so re-checks
  // and sweeps can find affected PRs. "cla_required" | "cla_stale" | "dco_missing".
  // Null for all other statuses (which use the close-PR machinery instead).
  gateReason    String?

  // GitHub Check Run id (string to avoid BigInt JSON pitfalls). Null when the
  // check publishing is disabled or the installation lacks `checks:write`.
  checkRunId String?
  // Separate Check Run id for the dedicated "contribution-checker / cla" check
  // (published independently of the overall decision check so CLA can be a
  // standalone required status check in branch protection).
  claCheckRunId String?
  // Latest commit SHA evaluated; used to detect re-eval on push (synchronize).
  headSha    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repo    Repo       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  quality PrQuality?

  @@unique([repoId, prNumber])
  @@index([authorGhLogin, status])
  @@index([authorGhId, status])
}

/**
 * PR Quality signals, 1:1 with PrCheck. Stores the *raw* signals (which
 * heuristics ran, what they found) so the final % score can be computed on
 * the fly using the project's current qualityConfig; config changes apply
 * instantly, no recompute job.
 */
model PrQuality {
  id         String   @id @default(cuid())
  prCheckId  String   @unique
  // JSON: { [heuristicId]: { failed: boolean, value?: any, reason?: string } }
  signalsRaw String   @default("{}")
  // JSON: cached fetched data (PR files+commits, account snapshot) so re-eval
  // doesn't require re-fetching everything on synchronize.
  fetchedRaw      String    @default("{}")
  computedAt      DateTime  @default(now())
  // Set when the public low-score warning comment has been posted, so
  // synchronize re-runs never post it a second time.
  warnCommentedAt DateTime?

  prCheck PrCheck @relation(fields: [prCheckId], references: [id], onDelete: Cascade)

  @@index([prCheckId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  // Null = app-level event (e.g. Vault resolution failure) not tied to a project.
  projectId String?
  actorId   String? // null = system
  kind      String  // e.g. "application.approved"
  // JSON-stringified
  payload   String  @default("{}")
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model FormTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  // JSON-stringified Field[]
  schema    String
  createdAt DateTime @default(now())

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerId])
}

model Notification {
  id      String   @id @default(cuid())
  userId  String
  kind    String
  // JSON-stringified
  payload String   @default("{}")
  readAt  DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  windowEnd DateTime
}

// Idempotency record for GitHub webhook deliveries. Keyed on the GitHub
// `x-github-delivery` UUID. Inserted on first receipt; the unique-constraint
// violation on retry short-circuits the handler so side effects (audit rows,
// outbound webhooks, label calls) don't multiply across GitHub's retry policy.
// Pruned periodically (24h retention is plenty, GitHub retries within a
// much shorter window).
model ProcessedWebhookDelivery {
  id        String   @id
  eventName String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== CLA (Contributor License Agreement) =====

/**
 * A versioned, immutable CLA document for a project. "Editing" a published
 * document means publishing a new version; old versions are retained forever
 * because signatures reference the exact text (bodyMarkdown + contentHash).
 * kind = "ICLA" (individual) | "CCLA" (corporate). Source is manual paste or a
 * repo file (e.g. CLA.md); for repo files the text is snapshotted at publish.
 */
model ClaDocumentVersion {
  id          String  @id @default(cuid())
  projectId   String
  kind        String  // "ICLA" | "CCLA"
  version     Int
  bodyMarkdown String  // snapshot of the exact text signed (even for repo-file source)
  contentHash String  // sha256(bodyMarkdown): the version hash

  sourceType      String  @default("manual") // "manual" | "repo_file"
  sourceRepoId    String?
  sourcePath      String?
  sourceRef       String?
  sourceCommitSha String?

  requireResign Boolean @default(false) // immutable: whether THIS publish forced re-sign at the time
  // Mutable per-version gate input: when true, a signature on this version no
  // longer satisfies coverage (the signer must re-sign). The current version is
  // never marked. This replaces the monotonic floor as the source of truth for
  // coverage; see src/lib/cla/status.ts. Toggled via setVersionResign (laddered
  // as doc.resign_set) or selected at publish time.
  resignRequired Boolean @default(false)
  publishedById String?                 // actor (plain snapshot, no FK)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signatures ClaSignature[]
  corporateClas CorporateCla[]

  @@unique([projectId, kind, version])
  @@index([projectId, kind])
}

/**
 * An immutable click-wrap signature event. NEVER updated or hard-deleted.
 * Admin "revocation" flips status (append-only); the original record stands.
 * Identity is snapshotted (ghId/ghLogin/email/legalName) so the record is
 * self-contained even if the User row is later deleted (userId → SetNull).
 */
model ClaSignature {
  id        String @id @default(cuid())
  projectId String
  versionId String
  kind      String // "ICLA" | "CCLA"

  userId        String?
  ghId          Int
  ghLogin       String
  emailSnapshot String?

  legalName       String  // printed full legal name (the signer's identity)
  affirmation     String  // exact "I agree ..." text shown at signing
  agreed          Boolean @default(true)
  documentVersion Int     // snapshot of the version number signed
  contentHash     String  // snapshot of the version hash signed

  // Signature capture. A typed name is not always a legally valid signature, so
  // contributors may type, draw, or upload one. signatureKind selects which:
  //   "typed"    -> signatureText holds the typed signature
  //   "drawn"    -> signatureImage holds a PNG data URL from the draw pad
  //   "uploaded" -> signatureImage holds the uploaded image as a data URL
  // The image bytes are retained immutably here; the ledger stores their hash.
  signatureKind  String? // "typed" | "drawn" | "uploaded"
  signatureText  String?
  signatureImage String? // data URL (image/png|jpeg|gif|webp)

  ip        String
  userAgent String @default("")

  applicationId String? // set when signed embedded in an application

  // JSON-stringified answers to the project's admin-defined CLA custom fields
  // ({ [fieldId]: value }), snapshotted at signing time. Null when none.
  customFields String?

  status       String  @default("ACTIVE") // "ACTIVE" | "REVOKED"
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?

  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     ClaDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  application Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  corporateSignatory CorporateCla? @relation("CclaSignatory")

  @@index([projectId, ghId, status])
  @@index([ghId])
  @@index([versionId])
  @@index([applicationId])
}

/**
 * A signed Corporate CLA. The signatory is a ClaSignature (kind=CCLA). The
 * company maintains a roster (CclaRosterMember) of covered GitHub accounts.
 */
model CorporateCla {
  id          String @id @default(cuid())
  projectId   String
  versionId   String
  signatureId String @unique

  // Executed corporate-signature block (legally binding). companyName is the
  // full legal entity name; signatoryTitle is the representative's Title;
  // contactEmail is the point-of-contact email. The remaining structured fields
  // are captured at signing. signatureText is the representative's typed
  // signature; the signing Date is the linked ClaSignature.signedAt (immutable
  // server timestamp). Nullable for backward compatibility; required for new
  // signings via the Zod validator.
  companyName       String  // Legal Entity (full legal name)
  registeredAddress String?
  country           String?
  contactName       String? // Point of contact (name)
  contactEmail      String  // Point of contact (email)
  signatoryTitle    String? // Authorized representative's Title
  signatureText     String? // Authorized representative's typed signature

  // Approval lifecycle. A CCLA starts PENDING when the project requires admin
  // approval (Project.claCorporateRequiresApproval), then ACTIVE (approved) or
  // REJECTED. REVOKED is the post-active maintainer override. Only ACTIVE
  // confers coverage on the roster. @default("ACTIVE") grandfathers pre-existing
  // rows; recordCclaSignature sets PENDING explicitly when approval is required.
  status      String @default("ACTIVE") // "PENDING" | "ACTIVE" | "REJECTED" | "REVOKED"
  approvedById String?
  approvedAt   DateTime?
  rejectedById String?
  rejectedAt   DateTime?
  rejectReason String?
  revokedById String?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   ClaDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  signature ClaSignature       @relation("CclaSignatory", fields: [signatureId], references: [id], onDelete: Restrict)
  members   CclaRosterMember[]

  @@index([projectId, status])
}

/**
 * A roster entry. Append-only state transitions; never hard-deleted. A member
 * is added (ACTIVE), revoked (REVOKED) by the signatory, or DISPUTED (the
 * listed contributor says they aren't affiliated, coverage suspended). A
 * DISPUTED account cannot be re-added unless the contributor consents.
 */
model CclaRosterMember {
  id          String @id @default(cuid())
  corporateId String
  projectId   String

  ghLogin String
  ghId    Int?

  status String @default("ACTIVE") // "ACTIVE" | "REVOKED" | "DISPUTED"

  addedById   String?
  addedAt     DateTime @default(now())
  revokedById String?
  revokedAt   DateTime?
  disputedAt  DateTime?
  disputeNote String?

  corporateCla CorporateCla @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, ghId, status])
  @@index([projectId, ghLogin, status])
  @@index([corporateId])
}

/**
 * Admin exemption: a specific GitHub account is treated as CLA-satisfied
 * (e.g. legal-team handshake). Append-only; revocation flips status.
 */
model ClaWaiver {
  id        String @id @default(cuid())
  projectId String
  ghLogin   String
  ghId      Int?
  reason    String

  grantedById String?
  grantedAt   DateTime @default(now())
  status      String   @default("ACTIVE") // "ACTIVE" | "REVOKED"
  revokedById String?
  revokedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, ghId, status])
  @@index([projectId, ghLogin, status])
}

/**
 * The per-project append-only, SHA-256 hash-chained legal ledger. Every
 * CLA-relevant event (signatures, document publications, roster add/revoke/
 * dispute, signature revocations, waivers) is recorded here. seq is a 0-based
 * monotonic counter per project (seq 0 = genesis). entryHash chains via
 * prevHash; @@unique([projectId, seq]) makes gaps/reordering impossible.
 * Link fields are plain scalars (no FK); this is an immutable record, never
 * cascaded or constrained. See src/lib/cla/integrity.ts for the hashing spec.
 */
model ClaEventLog {
  id        String @id @default(cuid())
  projectId String
  seq       Int
  kind      String // genesis | icla.signed | ccla.signed | ccla.approved | ccla.rejected | doc.published | doc.resign_set | roster.added | roster.revoked | roster.disputed | signature.revoked | waiver.granted | waiver.revoked

  payload     String // canonical (key-sorted) JSON snapshot
  actorUserId String?
  actorGhId   Int?

  signatureId       String? @unique
  documentVersionId String?
  rosterMemberId    String?
  corporateId       String?
  waiverId          String?

  prevHash  String
  entryHash String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, seq])
  @@index([projectId, kind])
}

/**
 * A detected-but-unpublished repo-file CLA change awaiting admin review. Created
 * only when Project.claRepoFileReviewMode is on: a push (or manual sync) that
 * changes the tracked file's content upserts the single PENDING row for
 * (projectId, kind, sourcePath) in place, so repeated pushes refresh one row
 * rather than spawning many. This is operational workflow state, NOT a legal
 * fact: it is audited but never written to the ClaEventLog hash chain. Approving
 * publishes a new ClaDocumentVersion (which IS laddered) and flips this to
 * APPROVED; rejecting flips to REJECTED; a content revert to the current
 * published hash flips to SUPERSEDED. detectedContent/contentHash snapshot what
 * was on the branch at detection so the approval can guard against drift.
 */
model ClaPendingChange {
  id        String @id @default(cuid())
  projectId String
  kind      String // "ICLA" | "CCLA"

  sourceRepoId    String
  sourcePath      String
  sourceRef       String?
  detectedCommitSha String?
  detectedContent   String
  contentHash       String // sha256(detectedContent) at detection time

  status String @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "SUPERSEDED"

  detectedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviewedById String?
  reviewedAt   DateTime?
  publishedVersionId String? // set on approve (plain pointer, no FK)
  rejectReason String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, kind, sourcePath, status])
}
