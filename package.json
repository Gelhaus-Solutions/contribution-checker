{
  "name": "contribution-checker",
  "version": "0.1.0",
  "author": "Gelhaus Solutions (Enno Gelhaus) <egelhaus@ennogelhaus.de> (https://ennogelhaus.de)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://ennogelhaus.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gelhaus-Solutions/contribution-checker.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node dist/worker.mjs",
    "worker:dev": "node scripts/build-worker.mjs && node dist/worker.mjs",
    "temporal:register-sa": "tsx scripts/register-search-attributes.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reader:generate": "prisma generate --schema=prisma/sqlite-reader.prisma",
    "db:migrate:sqlite-to-postgres": "tsx prisma/migrate-sqlite-to-postgres.ts",
    "db:verify:counts": "tsx prisma/verify-counts.ts",
    "db:backfill:sso-subjects": "tsx prisma/backfill-sso-subjects.ts",
    "db:encrypt-credentials": "node --experimental-strip-types --no-warnings prisma/encrypt-credentials.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@ghub/glockdown-sdk": "0.3.0",
    "@ghub/gmint-sdk": "^0.3.0",
    "@ghub/gpsso-sdk": "0.1.4",
    "@ghub/identity-chrome": "0.5.1",
    "@ghub/terms-client": "^0.1.0",
    "@ghub/terms-rules": "^0.1.3",
    "@octokit/app": "^16.1.4",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/webhooks": "^14.2.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@sentry/nextjs": "^11.12.0",
    "@sentry/profiling-node": "^11.12.0",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/interceptors-opentelemetry": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "minimatch": "^11.0.8",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@temporalio/testing": "^1.25.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.9"
}
