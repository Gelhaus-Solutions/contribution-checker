{
  "name": "contribution-checker",
  "version": "0.1.0",
  "author": "Gelhaus Solutions (Enno Gelhaus) <egelhaus@ennogelhaus.de> (https://ennogelhaus.de)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://ennogelhaus.de",
  "repository": {
    "type": "git",
    "url": "https://gitlab.ennogelhaus.de/gelhaus-corp/contribution-checker.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node dist/worker.mjs",
    "worker:dev": "node scripts/build-worker.mjs && node dist/worker.mjs",
    "temporal:register-sa": "tsx scripts/register-search-attributes.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reader:generate": "prisma generate --schema=prisma/sqlite-reader.prisma",
    "db:migrate:sqlite-to-postgres": "tsx prisma/migrate-sqlite-to-postgres.ts",
    "db:verify:counts": "tsx prisma/verify-counts.ts",
    "db:backfill:stack": "tsx prisma/backfill-stack-users.ts",
    "db:backfill:stack-teams": "tsx prisma/backfill-stack-teams.ts",
    "db:reconcile:github": "tsx prisma/reconcile-github-identity.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hexclave/next": "1.0.24",
    "@octokit/app": "^15.1.4",
    "@octokit/auth-app": "^7.2.1",
    "@octokit/webhooks": "^13.4.4",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@sentry/nextjs": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@temporalio/activity": "^1.18.1",
    "@temporalio/client": "^1.18.1",
    "@temporalio/common": "^1.18.1",
    "@temporalio/interceptors-opentelemetry": "^1.18.1",
    "@temporalio/worker": "^1.18.1",
    "@temporalio/workflow": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "jose": "^5.10.0",
    "lucide-react": "^0.469.0",
    "minimatch": "^10.0.1",
    "next": "15.1.4",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@temporalio/testing": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.4",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli"
    ]
  }
}
